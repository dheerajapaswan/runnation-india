# Public base URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future phases (server-side only, never prefix with NEXT_PUBLIC_):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Backend (Phase 4) ---
# Neon connection string. Never expose to the browser.
DATABASE_URL=
# Admin login password and the secret used to sign session cookies (use a long random value).
ADMIN_PASSWORD=
SESSION_SECRET=

# Automatic proof analysis (Claude vision). Leave key empty to keep manual review only.
ANTHROPIC_API_KEY=
# Auto-approve proofs whose screenshot matches distance, time and date.
PROOF_AUTO_APPROVE=false
